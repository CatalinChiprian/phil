
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PHIL_GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="220"
        x:Class="PHIL_GUI.PortsView"
        x:DataType="vm:PortsViewModel"
        Icon="/Assets/applied-nanotechnology.ico"
        Width="400" Height="220"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="PHIL_GUI">

  <StackPanel Margin="20">
      <Button Content="Get Available Ports"
              Command="{Binding GetPortsCommand}"
              Width="150" 
              Margin="0,5"
              HorizontalAlignment="Left"/>
                
      <ListBox ItemsSource="{Binding AvailablePorts}"
               SelectedItem="{Binding SelectedPort}"
               Height="80"
               Margin="0,10"/>
                
      <Button Content="Connect"
              Command="{Binding ConnectCommand}"
              Width="80"
              Background="#1EA1EB"
              Margin="0,0,10,0"/>
  </StackPanel>
</Window>
