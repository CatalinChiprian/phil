<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PHIL_GUI.ViewModels"
        xmlns:views="using:PHIL_GUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="PHIL_GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/applied-nanotechnology.ico"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" MinHeight="700"
        Title="PHIL_GUI">
    
    <!-- Main content area that switches between pages -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="topbar">
            <Grid Margin="20,10"
                  VerticalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <TextBlock Text="PHIL" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                LetterSpacing="1.5"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">
                    <Border Classes="badge">
						<StackPanel Orientation="Horizontal"
                                    Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse">
                                        <Style.Animations>
                                            <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="50%">
                                                    <Setter Property="Opacity" Value="0.3"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectedPort}"
                                       FontSize="10"
                                       LetterSpacing="0.5"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="btn btn-emergency" Content="Disconnect" Width="100" Command="{Binding DisconnectCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Classes="sidebar" Padding="15,20" Width="200">
			<StackPanel Orientation="Vertical"
                        Spacing="15" >
                <StackPanel Orientation="Vertical">
                    <TextBlock Classes="subtitle" Text="NAVIGATE"  LetterSpacing="2"/>
                    <ListBox Classes="nav"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="5" Height="5"/>
                                    <TextBlock Text="{Binding Title}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Height="1" Background="{StaticResource BorderColor}"/>

                <StackPanel Orientation="Vertical">
					<TextBlock Classes="subtitle" Text="POSITION"  LetterSpacing="2"/>
                    <Border Margin="5,14" Padding="14" Background="{StaticResource Surface2}" 
                            BorderThickness="1" BorderBrush="{StaticResource BorderColor}" CornerRadius="8">
                        <StackPanel Orientation="Vertical">
							<TextBlock Classes="subtitle" Text="CURRENT WELL" LetterSpacing="1.5"/>
                            <TextBlock Text="{Binding CurrentWell.Name}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Vertical" IsVisible="{Binding CurrentWell.IsStandard}">
                                <TextBlock Classes="subtitle" Text="{Binding CurrentWell.X, StringFormat='X: {0:F2}'}"/>
                                <TextBlock Classes="subtitle" Text="{Binding CurrentWell.Y, StringFormat='Y: {0:F2}'}"/>
                                <TextBlock Classes="subtitle" Text="{Binding CurrentWell.AngleL, StringFormat='L: {0:F2}°'}"/>
                                <TextBlock Classes="subtitle" Text="{Binding CurrentWell.AngleR, StringFormat='R: {0:F2}°'}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <Border Height="1" Background="{StaticResource BorderColor}"/>

                <StackPanel Orientation="Vertical" Spacing="5">
					<TextBlock Classes="subtitle" Text="Z AXIS"  LetterSpacing="2"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="btn btn-primary" Content="↑ Up" Padding="24,6"
                                Command="{Binding MoveUpCommand}"
                                IsEnabled="{Binding Limit.CanMoveUp}"/>
                        <Button Classes="btn btn-secondary" Content="↓ Down" Padding="18,6"
                                Command="{Binding MoveDownCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Classes="toolbar">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="8">
					<Button Classes="btn btn-primary" Content="Go Home"
                            Command="{Binding GoHomeCommand}"/>
                    <Button Classes="btn btn-emergency" Content="EMERGENCY STOP" FontWeight="SemiBold"
                            Command="{Binding EmergencyStopCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" 
                            HorizontalAlignment="Right"
                            Spacing="0">
					<Button Classes="toggle-btn"
                            Classes.active="{Binding Settings.Is96Well}"
                            CornerRadius="4 0 0 4"
                            Content="96-Well"
                            Command="{Binding SelectWell96Command}"/>

					<Button Classes="toggle-btn"
                            Classes.active="{Binding Settings.Is96Well, Converter={x:Static BoolConverters.Not}}"
                            CornerRadius="0 4 4 0"
                            Content="Organ-on-Chip"
                            Command="{Binding SelectOrganOnChipCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentPage}"
                        IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:WellsViewModel">
                    <views:WellsView />
                </DataTemplate>
                <DataTemplate DataType="vm:BasicControlsViewModel">
                    <views:BasicControlsView />
                </DataTemplate>
                <DataTemplate DataType="vm:CalibrationViewModel">
                    <views:CalibrationView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>
</Window>