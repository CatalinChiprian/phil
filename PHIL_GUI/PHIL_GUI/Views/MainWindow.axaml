<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PHIL_GUI.ViewModels"
        xmlns:views="using:PHIL_GUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="PHIL_GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/applied-nanotechnology.ico"
        WindowStartupLocation="CenterScreen"
        Title="PHIL_GUI">
    
    <!-- Main content area that switches between pages -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="topbar">
            <Grid Margin="20,10"
                  VerticalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <TextBlock Text="PHIL" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                LetterSpacing="1.5"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">
                    <Border BorderThickness="1"
                            CornerRadius="20"
                            Background="{StaticResource Accent-Dim}"
                            Padding="12,5"
                            BorderBrush="{StaticResource Accent-Mid}">
						<StackPanel Orientation="Horizontal"
                                    Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse">
                                        <Style.Animations>
                                            <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="50%">
                                                    <Setter Property="Opacity" Value="0.3"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectedPort}"
                                       FontSize="10"
                                       LetterSpacing="0.5"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="btn btn-emergency" Content="Disconnect" Width="100" Command="{Binding DisconnectCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Classes="sidebar">
			<StackPanel Orientation="Vertical"
                        Spacing="20" Margin="14,20">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="NAVIGATE" FontSize="9" Foreground="{StaticResource Muted}" LetterSpacing="2"/>
                    <ListBox Classes="nav"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="5" Height="5"/>
                                    <TextBlock Text="{Binding Title}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding CurrentPage}"
                        IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:BasicControlsViewModel">
                    <views:BasicControlsView />
                </DataTemplate>
                <DataTemplate DataType="vm:WellsViewModel">
                    <views:WellsView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>
</Window>