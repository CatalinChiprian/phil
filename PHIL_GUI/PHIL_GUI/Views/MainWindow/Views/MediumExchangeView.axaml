<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PHIL_GUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PHIL_GUI.Views.MediumExchangeView"
             x:DataType="vm:MediumExchangeViewModel">
    <Grid ColumnDefinitions="350, *, Auto">
        <Border Grid.Column="0" Classes="sidebar" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *">

                <Border Grid.Row="0" BorderThickness="0,0,0,1">
				    <DockPanel DockPanel.Dock="Top" Margin="15">
						<Button DockPanel.Dock="Right" 
                                Classes="btn btn-add"
                                Content="+"
                                Click="CreateActionButton_Click"
                                FontSize="15"
                                Padding="13,0"
                                ToolTip.Tip="Create Action"/>

					    <TextBlock DockPanel.Dock="Left" Classes="subtitle" FontSize="10" LetterSpacing="1.5" Text="ACTIONS"/>
                    </DockPanel>
                </Border>

                <!--Actions List-->
                <ScrollViewer Grid.Row="1">
					<ItemsControl ItemsSource="{Binding ActionItems}" Margin="10">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Classes="action-card" IsVisible="{Binding IsVisible}">
									<StackPanel Spacing="4" Margin="5" VerticalAlignment="Center">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
											<Border Grid.Column="0" Classes="action-badge" BorderBrush="{Binding ActionTypeBorderColor}" Background="{Binding ActionTypeBackgroundColor}">
                                                <TextBlock Text="{Binding ActionTypeLabel}" Foreground="{Binding ActionTypeTextColor}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Summary}"
                                                       FontSize="16"
                                                       FontWeight="Medium"/>
                                            <TextBlock Grid.Column="2"
                                                        Text="{Binding Id, StringFormat='#{0}'}"
                                                        Classes="subtitle"
                                                        FontSize="10"/>

                                        </Grid>

                                        <StackPanel Spacing="0">
                                            <TextBlock Classes="subtitle-secondary" Text="{Binding FrequencyLabel}" FontSize="10"/>
                                            <TextBlock Classes="subtitle-secondary" Text="{Binding PeriodLabel}" FontSize="10"/>
                                        </StackPanel>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,2,0,0">
                                            <Button Grid.Column="0" 
                                                    Classes="btn btn-secondary"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Padding="0"
                                                    Content="Edit"
                                                    Tag="{Binding}"
                                                    Click="EditActionButton_Click"/>
                                            <Button Grid.Column="1"
                                                    Classes="btn btn-emergency"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    Padding="0"
                                                    Content="Delete"
                                                    Tag="{Binding Id}"
                                                    Click="DeleteActionButton_Click"/>
                                        </Grid>
										
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>

        <DockPanel Grid.Column="1">

            <Border DockPanel.Dock="Bottom" Classes="bottombar">
				<Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <TextBlock Classes="subtitle" Text="{Binding SelectedWellsCount}"/>
                        <TextBlock Classes="subtitle" Text="{Binding ActionCount}"/>
                    </StackPanel>

                    <Border Grid.Column="1"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="btn btn-secondary" Content="Select All" Command="{Binding SelectAllCommand}"/>
                        <Button Classes="btn btn-secondary" Content="Clear Selection" Command="{Binding ClearSelectionCommand}"/>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding AppSettings.Is96Well, Converter={x:Static BoolConverters.Not}}">
							<Button Classes="btn btn-secondary" Content="Select Quad1" Command="{Binding SelectQ1Command}"/>
							<Button Classes="btn btn-secondary" Content="Select Quad2" Command="{Binding SelectQ2Command}"/>
							<Button Classes="btn btn-secondary" Content="Select Quad3" Command="{Binding SelectQ3Command}"/>
							<Button Classes="btn btn-secondary" Content="Select Quad4" Command="{Binding SelectQ4Command}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

		    <Border Background="{StaticResource Bg}" Padding="30,20">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Panel>

                            <!-- 96-Well Plate -->
                            <Grid IsVisible="{Binding AppSettings.Is96Well}" RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">

                               <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                            Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                                    <TextBlock Classes="subtitle" Text="96-WELL PLATE" FontSize="10" LetterSpacing="1.5"/>
                                    <Border Classes="badge" Padding="8,3">
                                        <TextBlock Text="8 × 12" FontSize="9"/>
                                    </Border>
                                </StackPanel>

                               <ItemsControl Grid.Row="1" Grid.Column="1"
                                             ItemsSource="{Binding WellPlate.ColHeaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="12" Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="subtitle" Text="{Binding}" 
                                                       Width="44"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Row="2" Grid.Column="0"
                                              ItemsSource="{Binding WellPlate.RowHeaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="8" Columns="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="subtitle" Text="{Binding}" 
                                                       Width="10"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="2" Grid.Column="1" ClipToBounds="False">
                                    <ItemsControl ItemsSource="{Binding WellPlateItem96.Wells}" ClipToBounds="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="8" Columns="12"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding Name}"
                                                        Classes="well calibrated"
                                                        Classes.active="{Binding IsSelected}"
                                                        IsVisible="{Binding IsVisible}"
                                                        Command="{Binding $parent[ItemsControl].((vm:MediumExchangeViewModel)DataContext).SelectTargetCommand}"
                                                        CommandParameter="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Grid>

                            <!-- Organ-on-Chip Plate -->
                            <Grid IsVisible="{Binding AppSettings.Is96Well, Converter={x:Static BoolConverters.Not}}"
                                  RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">

                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                                    <TextBlock Classes="subtitle" Text="ORGAN-ON-CHIP PLATE" FontSize="10" LetterSpacing="1.5"/>
                                    <Border Classes="badge" Padding="8,3">
                                        <TextBlock Text="4 × 6" FontSize="9"/>
                                    </Border>
                                </StackPanel>

                                <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WellPlate.ColHeaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="12" Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="subtitle" Text="{Binding}"
                                                       Width="44" TextAlignment="Center"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Margin="0,0,0,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl Grid.Row="2" Grid.Column="0" ItemsSource="{Binding WellPlate.RowHeaders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="8" Columns="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="subtitle" Text="{Binding}"
                                                       Width="10" TextAlignment="Center"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="2" Grid.Column="1" ClipToBounds="False">
                                    <Panel>
                                        <ItemsControl ItemsSource="{Binding WellPlateItemOoC.Wells}" ClipToBounds="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="4" Columns="6"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Classes="well-pair" Classes.active="{Binding IsSelected}" PointerPressed="Border_PointerPressed" Tag="{Binding PairIndex}">
                                                        <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                                            <Button Grid.Row="0" Grid.Column="0"
                                                                    Content="IN"
                                                                    IsEnabled="False"
                                                                    Classes="well calibrated"
                                                                    Classes.active="{Binding In.IsSelected}"
                                                                    CommandParameter="{Binding In.Name}"/>

                                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                                        Grid.RowSpan="2" Grid.ColumnSpan="2"
                                                                        Text="{Binding PairIndex}"
                                                                        Foreground="{StaticResource Muted}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,0,2"/>

                                                            <Button Grid.Row="1" Grid.Column="1"
                                                                    Content="OUT"
                                                                    IsEnabled="False"
                                                                    Classes="well calibrated"
                                                                    Classes.active="{Binding Out.IsSelected}"
                                                                    CommandParameter="{Binding Out.Name}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                            <Border Grid.Row="0" Grid.Column="0" Classes="quadrant"/>
                                            <Border Grid.Row="0" Grid.Column="1" Classes="quadrant"/>
                                            <Border Grid.Row="1" Grid.Column="0" Classes="quadrant"/>
                                            <Border Grid.Row="1" Grid.Column="1" Classes="quadrant"/>
                                        </Grid>
                                    </Panel>
                                </Border>
                            </Grid>

                        </Panel>
                    </Viewbox>

    <!--                <Border Background="{StaticResource Wall}"
                            IsVisible="{Binding Calibration.IsCalibrated, Converter={x:Static BoolConverters.Not}}"
                            ZIndex="10">
                        <Border Background="{StaticResource Surface2}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <TextBlock Text="Calibration required"
                                           FontWeight="SemiBold"
                                           LetterSpacing="1.5"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Classes="subtitle"
                                            Text="Please calibrate the system before using wells."
                                            LetterSpacing="1"
                                            Foreground="{StaticResource Muted}"
                                            TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>-->
                </Grid>
            </Border>

        </DockPanel>

        <Border Grid.Column="2" Classes="sidebar" Width="{Binding DetailsPageWidth}" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto, Auto, *">
                <Border Grid.Row="0" BorderThickness="0,0,0,1">
					<TextBlock DockPanel.Dock="Left" Classes="subtitle" 
                                FontSize="10" 
                                LetterSpacing="1.5"
                                Margin="15"
                                Text="WELL DETAILS"/>

                </Border>

                <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="0" Margin="12,10">
					<TextBlock Text="{Binding SelectedWellText}" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Classes="subtitle" Text="{Binding WellActionsText}"/>
                </StackPanel>

                <!--Sections-->
                <Grid Grid.Row="2" RowDefinitions="2*, Auto, *">
					
                    <!--Attached Actions-->
                    <Grid Grid.Row="0" RowDefinitions="Auto, *" RowSpacing="6" Margin="12, 8">
						<TextBlock Grid.Row="0"
                                   Classes="subtitle"
                                   FontSize="10"
                                   LetterSpacing="1.5"
                                   Text="ATTACHED"/>
                        <ScrollViewer Grid.Row="1">
							<ItemsControl ItemsSource="{Binding CurrentWellActions}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Classes="action-card" Margin="0,0,6,4" IsVisible="{Binding IsVisible}">
											<Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="6" Margin="8,6">
                                                <TextBlock Grid.Column="0"
                                                        Text="{Binding Id, StringFormat='#{0}'}"
                                                        Classes="subtitle"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"/>
										        <Border Grid.Column="1" Padding="2" Height="16" Classes="action-badge" BorderBrush="{Binding ActionTypeBorderColor}" Background="{Binding ActionTypeBackgroundColor}">
                                                    <TextBlock Padding="0" Margin="0" FontSize="10" Text="{Binding ActionTypeLabel}" Foreground="{Binding ActionTypeTextColor}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2"
                                                           Classes="subtitle"
                                                           Text="{Binding Summary}"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"/>

                                                <Button Grid.Column="3" Padding="0" Margin="0" Classes="btn btn-svg inline btn-svg-clear" Width="6" Height="6" ToolTip.Tip="Deatach Action" Click="DetachActionButton_Click" Tag="{Binding}">
													    <Path Classes="svg"
                                                                Width="6"
                                                                Height="6"
                                                                Data="M19.207 6.207a1 1 0 0 0-1.414-1.414L12 10.586 6.207 4.793a1 1 0 0 0-1.414 1.414L10.586 12l-5.793 5.793a1 1 0 1 0 1.414 1.414L12 13.414l5.793 5.793a1 1 0 0 0 1.414-1.414L13.414 12l5.793-5.793z"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Margin="12,0" Background="{StaticResource BorderColor}"/>

                    <!--Detached Actions-->
                    <Grid Grid.Row="2" RowDefinitions="Auto, *" RowSpacing="6" Margin="12,8">
						<TextBlock Grid.Row="0"
                                   Classes="subtitle"
                                   FontSize="10"
                                   LetterSpacing="1.5"
                                   Text="AVALABLE TO ATTACH"/>
                        <ScrollViewer Grid.Row="1">
							<ItemsControl ItemsSource="{Binding AvailableWellActions}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
									    <Border Classes="action-card" Margin="0,0,6,4" IsVisible="{Binding IsVisible}">
											<Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="6" Margin="8,6">
                                                <TextBlock Grid.Column="0"
                                                        Text="{Binding Id, StringFormat='#{0}'}"
                                                        Classes="subtitle"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"/>
										        <Border Grid.Column="1" Padding="2" Height="16" Classes="action-badge" BorderBrush="{Binding ActionTypeBorderColor}" Background="{Binding ActionTypeBackgroundColor}">
                                                    <TextBlock Padding="0" Margin="0" FontSize="10" Text="{Binding ActionTypeLabel}" Foreground="{Binding ActionTypeTextColor}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2"
                                                           Classes="subtitle"
                                                           Text="{Binding Summary}"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"/>
   
						                        <Button Grid.Column="3"
                                                        Classes="btn btn-add inline"
                                                        Content="+"
                                                        FontSize="16"
                                                        VerticalAlignment="Center"
                                                        Click="AttachActionButton_Click"
                                                        Tag="{Binding}"
                                                        ToolTip.Tip="Attach Action"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
