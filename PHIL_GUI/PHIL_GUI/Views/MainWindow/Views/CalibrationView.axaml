    <UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PHIL_GUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="PHIL_GUI.Views.CalibrationView"
             x:DataType="vm:CalibrationViewModel"
             Focusable="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="{Binding AppKeyBindings.MoveForwardKey}" Command="{Binding MoveForwardCommand}"/>
        <KeyBinding Gesture="{Binding AppKeyBindings.MoveLeftKey}" Command="{Binding MoveLeftCommand}"/>
        <KeyBinding Gesture="{Binding AppKeyBindings.MoveBackwardKey}" Command="{Binding MoveBackwardCommand}"/>
        <KeyBinding Gesture="{Binding AppKeyBindings.MoveRightKey}" Command="{Binding MoveRightCommand}"/>

        <KeyBinding Gesture="{Binding AppKeyBindings.IncreaseStepKey}" Command="{Binding IncreaseStepSizeCommand}"/>
        <KeyBinding Gesture="{Binding AppKeyBindings.DecreaseStepKey}" Command="{Binding DecreaseStepSizeCommand}"/>

        <KeyBinding Gesture="{Binding AppKeyBindings.RecordPositionKey}" Command="{Binding RecordPositionCommand}"/>
        <KeyBinding Gesture="{Binding AppKeyBindings.SolveMapKey}" Command="{Binding SolveMappingCommand}"/>
    </UserControl.KeyBindings>

    <DockPanel>
        <Border Classes="toolbar" DockPanel.Dock="Top">
		    <Grid ColumnDefinitions="*,Auto" Margin="20,10">
			    <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="15"
                            VerticalAlignment="Center">
					<TextBlock Classes="subtitle" LetterSpacing="2" Text="BASIC MOVEMENT" VerticalAlignment="Center"/>
                    <Grid Width="98" Height="98">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <!-- Front -->
                        <Button Grid.Row="0" Grid.Column="2" Classes="btn btn-svg"
                                Command="{Binding MoveForwardCommand}">
                            <Path Classes="svg"
                                  Width="9"
                                  Height="9"
                                  Data="M6 8L2 8L2 6L8 5.24536e-07L14 6L14 8L10 8L10 16L6 16L6 8Z"/>
                        </Button>
                        <!-- Left -->
                        <Button Grid.Row="2" Grid.Column="0" Classes="btn btn-svg"
                                Command="{Binding MoveLeftCommand}">
                            <Path Classes="svg"
                                  Width="9"
                                  Height="9"
                                  Data="M6 8L2 8L2 6L8 5.24536e-07L14 6L14 8L10 8L10 16L6 16L6 8Z">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="270"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <!-- Right -->
                        <Button Grid.Row="2" Grid.Column="4" Classes="btn btn-svg"
                                Command="{Binding MoveRightCommand}">
                            <Path Classes="svg"
                                  Width="9"
                                  Height="9"
                                  Data="M6 8L2 8L2 6L8 5.24536e-07L14 6L14 8L10 8L10 16L6 16L6 8Z">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <!-- Backward -->
                        <Button Grid.Row="4" Grid.Column="2" Classes="btn btn-svg"
                                Command="{Binding MoveBackwardCommand}">
                            <Path Classes="svg"
                                  Width="9"
                                  Height="9"
                                  Data="M6 8L2 8L2 6L8 5.24536e-07L14 6L14 8L10 8L10 16L6 16L6 8Z">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                    </Grid>

                    <Border Width="1" Height="40" Background="{StaticResource BorderColor}"/>

                    <TextBlock Classes="subtitle" LetterSpacing="2" Text="STEP SIZE" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="5">
						<Button Classes="btn btn-svg" Content="-"
                                IsEnabled="{Binding IsDecreaseStepSizeEnabled}"
                                Command="{Binding DecreaseStepSizeCommand}"
                                FontSize="15"
                                Padding="0"/>
                        <Border Classes="step-value" CornerRadius="4">
                            <TextBlock Text="{Binding Settings.StepSize, StringFormat='{}{0}x'}" 
                                       Foreground="{StaticResource Text}" 
                                       FontWeight="SemiBold"
                                       FontSize="12"/>
                        </Border>
						<Button Classes="btn btn-svg" Content="+"
                                Command="{Binding IncreaseStepSizeCommand}"
                                FontSize="15"
                                Padding="0"/>
                    </StackPanel>

                    <Border Width="1" Height="40" Background="{StaticResource BorderColor}"/>

                    <TextBlock Classes="subtitle" LetterSpacing="2" Text="PUMPS" VerticalAlignment="Center"/>

                    <Button Classes="btn btn-secondary" Content="Manual Control"
                            Click="PumpsButton_Click"/>
                    

                    <Border Width="1" Height="40" Background="{StaticResource BorderColor}"/>

                    <TextBlock Classes="subtitle" LetterSpacing="2" Text="RECORD" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
			            <Button Classes="btn btn-primary" Content="Record position"
                                IsEnabled="{Binding RecordEnabled}"
                                Command="{Binding RecordPositionCommand}"/>
                        <Button Classes="btn btn-secondary" Content="Solve"
                                IsEnabled="{Binding SolveEnabled}"
                                Command="{Binding SolveMappingCommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="5">
				    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel>
                            <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="RMS L"/>
						    <TextBlock Classes="metric-value" 
                                       Text="{Binding Calibration.RmsLText}"
                                       Foreground="{Binding Calibration.RmsLColor}"
                                       />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="RMS R"/>
						    <TextBlock Classes="metric-value" 
                                       Text="{Binding Calibration.RmsRText}"
                                       Foreground="{Binding Calibration.RmsRColor}"
                                       />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*, Auto">

		    <Border Grid.Column="0" Background="{StaticResource Bg}" Padding="30,20">
                <Viewbox Stretch="Uniform">
                    <Panel>
                        <!-- Organ-on-Chip Plate -->
                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                                <TextBlock Classes="subtitle" Text="ORGAN-ON-CHIP PLATE" FontSize="10" LetterSpacing="1.5"/>
                                <Border Classes="badge" Padding="8,3">
                                    <TextBlock Text="4 × 6" FontSize="9"/>
                                </Border>
                            </StackPanel>

                            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WellPlate.ColHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="12" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="subtitle" Text="{Binding}"
                                                    Width="44" TextAlignment="Center"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Margin="0,0,0,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Row="2" Grid.Column="0" ItemsSource="{Binding WellPlate.RowHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="8" Columns="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="subtitle" Text="{Binding}"
                                                    Width="10" TextAlignment="Center"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Margin="0,0,10,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="2" Grid.Column="1" ClipToBounds="False">
                                <Panel>
                                    <ItemsControl ItemsSource="{Binding WellPlateOoC.Wells}" ClipToBounds="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="4" Columns="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="well-pair" IsVisible="{Binding IsVisible}">
                                                    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                                        <Button Grid.Row="0" Grid.Column="0"
                                                                Content="{Binding In.Name}"
                                                                Classes="well"
                                                                Classes.ok="{Binding In.Calibration?.IsOk}"
                                                                Classes.caution="{Binding In.Calibration?.IsCaution}"
                                                                Classes.warn="{Binding In.Calibration?.IsWarn}"
                                                                Classes.no-record="{Binding In.IsCalibrated, Converter={x:Static BoolConverters.Not}}"
                                                                Classes.active="{Binding In.IsSelected}"
                                                                Command="{Binding $parent[ItemsControl].((vm:CalibrationViewModel)DataContext).WellsPositionCommand}"
                                                                CommandParameter="{Binding In.Name}"/>

                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                    Grid.RowSpan="2" Grid.ColumnSpan="2"
                                                                    Text="{Binding PairIndex}"
                                                                    Foreground="{StaticResource Muted}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,0,2"/>

                                                        <Button Grid.Row="1" Grid.Column="1"
                                                                Content="{Binding Out.Name}"
                                                                Classes="well"
                                                                Classes.ok="{Binding Out.Calibration?.IsOk}"
                                                                Classes.caution="{Binding Out.Calibration?.IsCaution}"
                                                                Classes.warn="{Binding Out.Calibration?.IsWarn}"
                                                                Classes.no-record="{Binding Out.IsCalibrated, Converter={x:Static BoolConverters.Not}}"
                                                                Classes.active="{Binding Out.IsSelected}"
                                                                Command="{Binding $parent[ItemsControl].((vm:CalibrationViewModel)DataContext).WellsPositionCommand}"
                                                                CommandParameter="{Binding Out.Name}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                        <Border Grid.Row="0" Grid.Column="0" Classes="quadrant"/>
                                        <Border Grid.Row="0" Grid.Column="1" Classes="quadrant"/>
                                        <Border Grid.Row="1" Grid.Column="0" Classes="quadrant"/>
                                        <Border Grid.Row="1" Grid.Column="1" Classes="quadrant"/>
                                    </Grid>
                                </Panel>
                            </Border>
                        </Grid>

                    </Panel>
                </Viewbox>
            </Border>

            <Border Grid.Column="1" Classes="sidebar" BorderThickness="1,0,0,0" Width="350">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
		            <Border BorderThickness="0,0,0,1" Grid.Row="0">
                        <DockPanel Margin="15, 10">
						    <TextBlock DockPanel.Dock="Right" Classes="subtitle" FontSize="10" LetterSpacing="1.5" Text="{Binding Calibration.Count, StringFormat='{}{0} pts'}"/>

						    <TextBlock DockPanel.Dock="Left" Classes="subtitle" FontSize="10" LetterSpacing="1.5" Text="CALIBRATION POINTS"/>
                        </DockPanel>
                    </Border>
                
                    <Border BorderThickness="0,0,0,1" Grid.Row="1" Background="{StaticResource Surface2}">
					    <StackPanel Orientation="Horizontal" Margin="15,5" Spacing="12">
						    <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}"/>
                                <TextBlock Classes="subtitle" Text="&lt; 1°"/>
                            </StackPanel>

						    <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Caution}"/>
                                <TextBlock Classes="subtitle" Text="1-2°"/>
                            </StackPanel>

						    <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Warn}"/>
                                <TextBlock Classes="subtitle" Text="&gt; 2°"/>
                            </StackPanel>

						    <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BorderColor}"
                                         StrokeThickness="1" Stroke="{StaticResource Text}"/>
                                <TextBlock Classes="subtitle" Text="recorded"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid Name="CalibrationGrid" Grid.Row="2"
                                GridLinesVisibility="Horizontal"
                                ItemsSource="{Binding Calibration.Points}"
                                IsReadOnly="True"
                                SelectedItem="{Binding SelectedCalibrationPoint}">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="WELL"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="70"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Accent}"/>

                            <DataGridTextColumn Header="X / Y"
                                                Binding="{Binding XY}"
                                                MinWidth="85"
                                                Width="*"/>

                            <DataGridTemplateColumn Header="ERR L" Width="2*" SortMemberPath="ErrLVal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" 
                                                    VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding ErrL}"
                                                        FontSize="10"
                                                        Foreground="{Binding ErrLColor}"/>
                                            <Border Height="3" 
                                                    Width="{Binding ErrLBarWidth}" 
                                                    CornerRadius="2"
                                                    Background="{Binding ErrLColor}"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ERR R" Width="2*" SortMemberPath="ErrRVal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" 
                                                    VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding ErrR}"
                                                        FontSize="10"
                                                        Foreground="{Binding ErrRColor}"/>
                                            <Border Height="3" 
                                                    Width="{Binding ErrRBarWidth}" 
                                                    CornerRadius="2"
                                                    Background="{Binding ErrRColor}"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="{StaticResource Surface2}" BorderThickness="1,1,0,0"
                            IsVisible="{Binding IsWellMenuVisibile}">
                        <StackPanel Margin="14, 16" Spacing="10">

                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Classes="subtitle" FontSize="10" LetterSpacing="1.5" Text="SELECTED POINT —"/>
                                <Border Classes="badge" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedCalibrationPoint.Name}" FontSize="9"/>
                                </Border>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*">

                                <StackPanel Grid.Column="0" Spacing="14">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="subtitle" Text="XY" LetterSpacing="1"/>
                                        <TextBlock Classes="metric-value" Text="{Binding SelectedCalibrationPoint.XY}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                                        <TextBlock Classes="subtitle" Text="Error L" LetterSpacing="1"/>
                                        <TextBlock Classes="metric-value" Text="{Binding SelectedCalibrationPoint.ErrL}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="14">
                                    <StackPanel Spacing="5">
                                        <TextBlock Classes="subtitle" Text="Angles L / R" LetterSpacing="1"/>
                                        <TextBlock Classes="metric-value" Text="{Binding CurrentWell.Angles}"/>
                                    </StackPanel>

								    <StackPanel Spacing="5">
                                        <TextBlock Classes="subtitle" Text="Error R" LetterSpacing="1"/>
                                        <TextBlock Classes="metric-value" Text="{Binding SelectedCalibrationPoint.ErrR}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="btn btn-primary" Content="Go To Well"
                                        Command="{Binding GoToSelectedWellCommand}"/>
								<Button Classes="btn btn-emergency" Content="Delete &amp; re-record"
                                        Command="{Binding DeleteRecordPositionCommand}"/>
                                
                                <Button Classes="btn btn-secondary" Content="Cancel"
                                        Command="{Binding CancelCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
