<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PHIL_GUI.ViewModels"
        xmlns:views="using:PHIL_GUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="PHIL_GUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/applied-nanotechnology.ico"
        WindowStartupLocation="CenterScreen"
        MinWidth="1100" MinHeight="600"
        Title="PHIL_GUI"
        Focusable="True">

    <Window.KeyBindings>
		<KeyBinding Gesture="H" Command="{Binding GoHomeCommand}"/>
        <KeyBinding Gesture="C" Command="{Binding CalibrateHomeCommand}"/>
        <KeyBinding Gesture="Up" Command="{Binding MoveUpCommand}"/>
        <KeyBinding Gesture="Down" Command="{Binding MoveDownCommand}"/>
    </Window.KeyBindings>
    
    <!-- Main content area that switches between pages -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="topbar">
            <Grid Margin="20,10"
                  VerticalAlignment="Stretch">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">

                    <TextBlock Text="PHIL" 
                                FontSize="16"
                                FontWeight="SemiBold"
                                LetterSpacing="1.5"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">
                    <Border Classes="badge">
						<StackPanel Orientation="Horizontal"
                                    Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}">
                                <Ellipse.Styles>
                                    <Style Selector="Ellipse">
                                        <Style.Animations>
                                            <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
                                                <KeyFrame Cue="0%">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="50%">
                                                    <Setter Property="Opacity" Value="0.3"/>
                                                </KeyFrame>
                                                <KeyFrame Cue="100%">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </KeyFrame>
                                            </Animation>
                                        </Style.Animations>
                                    </Style>
                                </Ellipse.Styles>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectedPort}"
                                       FontSize="10"
                                       LetterSpacing="0.5"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="btn btn-secondary"
                            Content="Disconnect"
                            Width="100"
                            Command="{Binding DisconnectCommand}"/>

                    <Button Classes="btn btn-svg"
                            Command="{Binding OpenSettingsCommand}">
                        <Path Stretch="Fill"
                              Width="15"
                              Height="15"
                              Data="M 15 12 A 3 3 0 1 0 9 12 A 3 3 0 1 0 15 12 Z
                              M13.7654 2.15224C13.3978 2 12.9319 2 12 2C11.0681 2 10.6022 2
                              10.2346 2.15224C9.74457 2.35523 9.35522 2.74458 9.15223
                              3.23463C9.05957 3.45834 9.0233 3.7185 9.00911
                              4.09799C8.98826 4.65568 8.70226 5.17189 8.21894
                              5.45093C7.73564 5.72996 7.14559 5.71954 6.65219
                              5.45876C6.31645 5.2813 6.07301 5.18262 5.83294
                              5.15102C5.30704 5.08178 4.77518 5.22429 4.35436
                              5.5472C4.03874 5.78938 3.80577 6.1929 3.33983
                              6.99993C2.87389 7.80697 2.64092 8.21048 2.58899
                              8.60491C2.51976 9.1308 2.66227 9.66266 2.98518
                              10.0835C3.13256 10.2756 3.3397 10.437 3.66119
                              10.639C4.1338 10.936 4.43789 11.4419 4.43786
                              12C4.43783 12.5581 4.13375 13.0639 3.66118
                              13.3608C3.33965 13.5629 3.13248 13.7244 2.98508
                              13.9165C2.66217 14.3373 2.51966 14.8691 2.5889
                              15.395C2.64082 15.7894 2.87379 16.193 3.33973
                              17C3.80568 17.807 4.03865 18.2106 4.35426
                              18.4527C4.77508 18.7756 5.30694 18.9181 5.83284
                              18.8489C6.07289 18.8173 6.31632 18.7186 6.65204
                              18.5412C7.14547 18.2804 7.73556 18.27 8.2189
                              18.549C8.70224 18.8281 8.98826 19.3443 9.00911
                              19.9021C9.02331 20.2815 9.05957 20.5417 9.15223
                              20.7654C9.35522 21.2554 9.74457 21.6448 10.2346
                              21.8478C10.6022 22 11.0681 22 12 22C12.9319 22 13.3978 22
                              13.7654 21.8478C14.2554 21.6448 14.6448 21.2554 14.8477
                              20.7654C14.9404 20.5417 14.9767 20.2815 14.9909
                              19.902C15.0117 19.3443 15.2977 18.8281 15.781
                              18.549C16.2643 18.2699 16.8544 18.2804 17.3479
                              18.5412C17.6836 18.7186 17.927 18.8172 18.167
                              18.8488C18.6929 18.9181 19.2248 18.7756 19.6456
                              18.4527C19.9612 18.2105 20.1942 17.807 20.6601
                              16.9999C21.1261 16.1929 21.3591 15.7894 21.411
                              15.395C21.4802 14.8691 21.3377 14.3372 21.0148
                              13.9164C20.8674 13.7243 20.6602 13.5628 20.3387
                              13.3608C19.8662 13.0639 19.5621 12.558 19.5621
                              11.9999C19.5621 11.4418 19.8662 10.9361 20.3387
                              10.6392C20.6603 10.4371 20.8675 10.2757 21.0149
                              10.0835C21.3378 9.66273 21.4803 9.13087 21.4111
                              8.60497C21.3592 8.21055 21.1262 7.80703 20.6602
                              7C20.1943 6.19297 19.9613 5.78945 19.6457
                              5.54727C19.2249 5.22436 18.693 5.08185 18.1671
                              5.15109C17.9271 5.18269 17.6837 5.28136 17.3479
                              5.4588C16.8545 5.71959 16.2644 5.73002 15.7811
                              5.45096C15.2977 5.17191 15.0117 4.65566 14.9909
                              4.09794C14.9767 3.71848 14.9404 3.45833 14.8477
                              3.23463C14.6448 2.74458 14.2554 2.35523 13.7654 2.15224Z"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Left" Classes="sidebar" Padding="15,20" Width="200">
			<StackPanel Orientation="Vertical"
                        Spacing="15" >
                <StackPanel Orientation="Vertical">
                    <TextBlock Classes="subtitle" Text="NAVIGATE" LetterSpacing="2"/>
                    <ListBox Classes="nav"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="5" Height="5"/>
                                    <TextBlock Text="{Binding Title}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Height="1" Background="{StaticResource BorderColor}"/>

                <StackPanel Orientation="Vertical">
					<TextBlock Classes="subtitle" Text="POSITION"  LetterSpacing="2"/>
                    <Border Margin="5,14" Padding="14" Background="{StaticResource Surface2}" 
                            BorderThickness="1" BorderBrush="{StaticResource BorderColor}" CornerRadius="8">
                        <StackPanel Orientation="Vertical">
							<TextBlock Classes="subtitle" Text="CURRENT WELL" LetterSpacing="1.5"/>
                            <TextBlock Text="{Binding CurrentWell.Name}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Vertical" IsVisible="{Binding CurrentWell.IsStandard}">
                                <TextBlock Classes="subtitle" Text="{Binding CurrentWell.X, StringFormat='X: {0:F2}'}"/>
                                <TextBlock Classes="subtitle" Text="{Binding CurrentWell.Y, StringFormat='Y: {0:F2}'}"/>
                                <TextBlock Classes="subtitle" Text="{Binding CurrentWell.AngleL, StringFormat='L: {0:F2}°'}"/>
                                <TextBlock Classes="subtitle" Text="{Binding CurrentWell.AngleR, StringFormat='R: {0:F2}°'}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <Border Height="1" Background="{StaticResource BorderColor}"/>

                <StackPanel Orientation="Vertical" Spacing="5">
					<TextBlock Classes="subtitle" Text="Z AXIS"  LetterSpacing="2"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="btn btn-primary" Content="↑ Up" Padding="24,6"
                                Command="{Binding MoveUpCommand}"
                                IsEnabled="{Binding Limit.CanMoveUp}"/>
                        <Button Classes="btn btn-secondary" Content="↓ Down" Padding="18,6"
                                Command="{Binding MoveDownCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Classes="toolbar">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="8">
					<Button Classes="btn btn-primary" Content="Go Home"
                            Command="{Binding GoHomeCommand}"/>
					<Button Classes="btn btn-secondary" Content="Calibrate Home"
                            Command="{Binding CalibrateHomeCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" 
                            HorizontalAlignment="Right" Spacing="8">
                    <StackPanel Orientation="Horizontal"
                                Spacing="0">
					    <Button Classes="toggle-btn"
                                Classes.active="{Binding Settings.Is96Well}"
                                CornerRadius="4 0 0 4"
                                Content="96-Well"
                                Command="{Binding SelectWell96Command}"/>

					    <Button Classes="toggle-btn"
                                Classes.active="{Binding Settings.Is96Well, Converter={x:Static BoolConverters.Not}}"
                                CornerRadius="0 4 4 0"
                                Content="Organ-on-Chip"
                                Command="{Binding SelectOrganOnChipCommand}"/>
                    </StackPanel>

                    <Border Width="1" Height="25" Background="{StaticResource BorderColor}"/>

                    <Button Classes="btn btn-emergency" Content="Emergency Stop" FontWeight="SemiBold"
                            Command="{Binding EmergencyStopCommand}" FontSize="10"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentPage}"
                        IsVisible="{Binding CurrentPage, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:WellsViewModel">
                    <views:WellsView />
                </DataTemplate>
                <DataTemplate DataType="vm:BasicControlsViewModel">
                    <views:BasicControlsView />
                </DataTemplate>
                <DataTemplate DataType="vm:CalibrationViewModel">
                    <views:CalibrationView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </DockPanel>
</Window>