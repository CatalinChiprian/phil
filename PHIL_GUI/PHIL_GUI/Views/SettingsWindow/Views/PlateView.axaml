<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PHIL_GUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PHIL_GUI.Views.PlateView"
             x:DataType="vm:PlateViewModel">
    <!--Plate type selection toggle-->
    <Grid ColumnDefinitions="*,*" Margin="10,20" VerticalAlignment="Top">
        <StackPanel Grid.Column="0" Spacing="8"
                    VerticalAlignment="Center">
            <TextBlock Classes="subtitle"
                        FontSize="13"
                        Text="Default Plate Type"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8"
                    VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Spacing="0">
			    <Button Classes="toggle-btn"
                        Classes.active="{Binding Is96Well, Converter={x:Static BoolConverters.Not}}"
                        CornerRadius="0 4 4 0"
                        Content="Organ-on-Chip"
                        Command="{Binding SelectOrganOnChipCommand}"/>

			    <Button Classes="toggle-btn"
                        Classes.active="{Binding Is96Well}"
                        CornerRadius="4 0 0 4"
                        Content="96-Well"
                        Command="{Binding SelectWell96Command}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
