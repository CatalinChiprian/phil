<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PHIL_GUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PHIL_GUI.Views.WellsView"
             x:DataType="vm:WellsViewModel">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="bottombar">
			<StackPanel Orientation="Horizontal">
				<StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel>
                        <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="CALIBRATION RMS"/>
						<TextBlock Classes="metric-value" 
                                   Text="{Binding RmsDisplayText}" 
                                   Foreground="{Binding RmsColor}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="CAL. POINTS"/>
						<TextBlock Classes="metric-value" 
                                   Text="{Binding CalPointsText}"
                                   Foreground="{Binding CalPointsColor}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="MICROSTEPS"/>
						<TextBlock Classes="metric-value"
                                   Text="{Binding MicrostepsText}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Classes="toolbar">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="8">
					<Button Classes="btn btn-primary" Content="Go Home"
                            Command="{Binding GoHomeCommand}"/>
                    <Button Classes="btn btn-emergency" Content="EMERGENCY STOP" FontWeight="SemiBold"
                            Command="{Binding EmergencyStopCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" 
                            HorizontalAlignment="Right"
                            Spacing="0">
					<Button Classes="toggle-btn active"
                            CornerRadius="4 0 0 4"
                            Content="96-Well"
                            Command="{Binding SelectPlateTypeCommand}"
                            CommandParameter="96"/>

					<Button Classes="toggle-btn"
                            CornerRadius="0 4 4 0"
                            Content="Heart-on-Chip"
                            Command="{Binding SelectPlateTypeCommand}"
                            CommandParameter="hoc"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{StaticResource Accent-Dim}" 
                Padding="30,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Accent-Mid}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TopNotificationText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

		<Border Background="{StaticResource Bg}" Padding="60,40">
            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">

                   <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                        <TextBlock Classes="subtitle" Text="96-WELL PLATE" FontSize="10" LetterSpacing="1.5"/>
                        <Border Classes="badge" Padding="8,3">
                            <TextBlock Text="8 × 12" FontSize="9"/>
                        </Border>
                    </StackPanel>

                   <ItemsControl Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center"
                                 ItemsSource="{Binding ColHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="subtitle" Text="{Binding}" 
                                           Width="44" 
                                           Height="10"
                                           TextAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                  Margin="0,14,0,0"
                                  ItemsSource="{Binding RowHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Classes="subtitle" Text="{Binding}" 
                                           Height="44" 
                                           Width="10"
                                           TextAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Margin="0,0,10,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <!-- Wells -->
                        <ItemsControl ItemsSource="{Binding Wells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="8" Columns="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}"
                                            Classes="well"
                                            Command="{Binding $parent[ItemsControl].((vm:WellsViewModel)DataContext).WellsPositionCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>
