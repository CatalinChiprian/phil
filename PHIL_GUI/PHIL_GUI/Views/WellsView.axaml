<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PHIL_GUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PHIL_GUI.Views.WellsView"
             x:DataType="vm:WellsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.well">
            <Setter Property="Command" Value="{Binding WellsPositionCommand}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="bottombar">
			<StackPanel Orientation="Horizontal">
				<StackPanel Orientation="Horizontal" Spacing="20">
                    <StackPanel>
                        <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="CALIBRATION RMS"/>
						<TextBlock Classes="metric-value" Text="L 0.57°  R 0.83°"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="CAL. POINTS"/>
						<TextBlock Classes="metric-value" Text="L 0.57°  R 0.83°"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Wells -->
        <ItemsControl ItemsSource="{Binding Wells}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8" Columns="12"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}"
                            Classes="well"
                            CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</UserControl>