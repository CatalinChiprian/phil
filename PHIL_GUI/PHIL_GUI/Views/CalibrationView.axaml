<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PHIL_GUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="PHIL_GUI.Views.CalibrationView"
             x:DataType="vm:CalibrationViewModel">

    <DockPanel>
        <Border Classes="toolbar" DockPanel.Dock="Top">
		    <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Spacing="5">
				    <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel>
                            <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="RMS L"/>
						    <TextBlock Classes="metric-value" 
                                       Text="0.57" 
                                       />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="subtitle" LetterSpacing="1.5" Text="RMS R"/>
						    <TextBlock Classes="metric-value" 
                                       Text="0.83"
                                       />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

			    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Spacing="15" VerticalAlignment="Center">
					<TextBlock Classes="subtitle" LetterSpacing="2" Text="BASIC MOVEMENT" VerticalAlignment="Center"/>
                    <Grid Width="98" Height="98">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="2"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <!-- Front -->
                        <Button Grid.Row="0" Grid.Column="2" Classes="btn btn-dpad"
                                Command="{Binding MoveForwardCommand}">
                            <Path Data="M6 8L2 8L2 6L8 5.24536e-07L14 6L14 8L10 8L10 16L6 16L6 8Z"
                                  Stretch="Fill"
                                  Width="9"
                                  Height="9"/>
                        </Button>
                        <!-- Left -->
                        <Button Grid.Row="2" Grid.Column="0" Classes="btn btn-dpad"
                                Command="{Binding MoveLeftCommand}">
                            <Path Data="M6 8L2 8L2 6L8 5.24536e-07L14 6L14 8L10 8L10 16L6 16L6 8Z"
                                  Stretch="Fill"
                                  Width="9"
                                  Height="9">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="270"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <!-- Right -->
                        <Button Grid.Row="2" Grid.Column="4" Classes="btn btn-dpad"
                                Command="{Binding MoveRightCommand}">
                            <Path Data="M6 8L2 8L2 6L8 5.24536e-07L14 6L14 8L10 8L10 16L6 16L6 8Z"
                                  Stretch="Fill"
                                  Width="9"
                                  Height="9">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                        <!-- Backward -->
                        <Button Grid.Row="4" Grid.Column="2" Classes="btn btn-dpad"
                                Command="{Binding MoveBackwardCommand}" IsEnabled="False">
                            <Path Data="M6 8L2 8L2 6L8 5.24536e-07L14 6L14 8L10 8L10 16L6 16L6 8Z"
                                  Stretch="Fill"
                                  Width="9"
                                  Height="9">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180"/>
                                </Path.RenderTransform>
                            </Path>
                        </Button>
                    </Grid>

                    <Border Width="1" Height="40" Background="{StaticResource BorderColor}"/>

                    <TextBlock Classes="subtitle" LetterSpacing="2" Text="STEP SIZE" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="5">
						<Button Classes="btn btn-dpad" Content="-"
                                Command="{Binding DecreaseStepSize}"
                                FontSize="15"
                                Padding="0"/>
                        <Border Classes="step-value" CornerRadius="4">
                            <TextBlock Text="0.10x" Foreground="{StaticResource Text}" 
                                       FontWeight="SemiBold" FontSize="12"/>
                        </Border>
						<Button Classes="btn btn-dpad" Content="+"
                                Command="{Binding IncreaseStepSize}"
                                FontSize="15"
                                Padding="0"/>
                    </StackPanel>


                    <Border Width="1" Height="40" Background="{StaticResource BorderColor}"/>

                    <TextBlock Classes="subtitle" LetterSpacing="2" Text="RECORD" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
			            <Button Classes="btn btn-primary" Content="Record position"
                                IsEnabled="{Binding RecordEnabled}"
                                Command="{Binding RecordPositionCommand}"/>
                        <Button Classes="btn btn-secondary" Content="Solve"
                                IsEnabled="{Binding SolveEnabled}"
                                Command="{Binding SolveMappingCommand}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="*, Auto">

		    <Border Grid.Column="0" Background="{StaticResource Bg}" Padding="30,20">
                <Viewbox Stretch="Uniform">
                    <Panel>

                        <!-- 96-Well Plate -->
                        <Grid IsVisible="{Binding Settings.Is96Well}" RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                                        Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                                <TextBlock Classes="subtitle" Text="96-WELL PLATE" FontSize="10" LetterSpacing="1.5"/>
                                <Border Classes="badge" Padding="8,3">
                                    <TextBlock Text="8 × 12" FontSize="9"/>
                                </Border>
                            </StackPanel>

                            <ItemsControl Grid.Row="1" Grid.Column="1"
                                            ItemsSource="{Binding WellPlate.ColHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="12" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="subtitle" Text="{Binding}" 
                                                    Width="44"
                                                    TextAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Row="2" Grid.Column="0"
                                            ItemsSource="{Binding WellPlate.RowHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="8" Columns="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="subtitle" Text="{Binding}" 
                                                    Width="10"
                                                    TextAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,10,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="2" Grid.Column="1" ClipToBounds="False">
                                <ItemsControl ItemsSource="{Binding WellPlate.Wells96}" ClipToBounds="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="8" Columns="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Name}"
                                                    Classes="well"
                                                    Classes.active="{Binding IsSelected}"
                                                    IsVisible="{Binding IsVisible}"
                                                    Command="{Binding $parent[ItemsControl].((vm:CalibrationViewModel)DataContext).WellsPositionCommand}"
                                                    CommandParameter="{Binding Name}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>

                        <!-- Organ-on-Chip Plate -->
                        <Grid IsVisible="{Binding Settings.Is96Well, Converter={x:Static BoolConverters.Not}}"
                                RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, Auto">

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
                                <TextBlock Classes="subtitle" Text="ORGAN-ON-CHIP PLATE" FontSize="10" LetterSpacing="1.5"/>
                                <Border Classes="badge" Padding="8,3">
                                    <TextBlock Text="4 × 6" FontSize="9"/>
                                </Border>
                            </StackPanel>

                            <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding WellPlate.ColHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="12" Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="subtitle" Text="{Binding}"
                                                    Width="44" TextAlignment="Center"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Margin="0,0,0,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Row="2" Grid.Column="0" ItemsSource="{Binding WellPlate.RowHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="8" Columns="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Classes="subtitle" Text="{Binding}"
                                                    Width="10" TextAlignment="Center"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Margin="0,0,10,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Grid.Row="2" Grid.Column="1" ClipToBounds="False">
                                <Panel>
                                    <ItemsControl ItemsSource="{Binding WellPlate.WellsOoC}" ClipToBounds="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="4" Columns="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="well-pair" IsVisible="{Binding IsVisible}">
                                                    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                                        <Button Grid.Row="0" Grid.Column="0"
                                                                Content="{Binding In.Name}"
                                                                Classes="well"
                                                                Classes.active="{Binding In.IsSelected}"
                                                                Command="{Binding $parent[ItemsControl].((vm:CalibrationViewModel)DataContext).WellsPositionCommand}"
                                                                CommandParameter="{Binding In.Name}"/>

                                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                                    Grid.RowSpan="2" Grid.ColumnSpan="2"
                                                                    Text="{Binding PairIndex}"
                                                                    Foreground="{StaticResource Muted}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,0,2"/>

                                                        <Button Grid.Row="1" Grid.Column="1"
                                                                Content="{Binding Out.Name}"
                                                                Classes="well"
                                                                Classes.active="{Binding Out.IsSelected}"
                                                                Command="{Binding $parent[ItemsControl].((vm:CalibrationViewModel)DataContext).WellsPositionCommand}"
                                                                CommandParameter="{Binding Out.Name}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                        <Border Grid.Row="0" Grid.Column="0" Classes="quadrant"/>
                                        <Border Grid.Row="0" Grid.Column="1" Classes="quadrant"/>
                                        <Border Grid.Row="1" Grid.Column="0" Classes="quadrant"/>
                                        <Border Grid.Row="1" Grid.Column="1" Classes="quadrant"/>
                                    </Grid>
                                </Panel>
                            </Border>
                        </Grid>

                    </Panel>
                </Viewbox>
            </Border>

            <Border Grid.Column="1" Classes="sidebar" BorderThickness="1,0,0,0" Width="350">
                <Grid RowDefinitions="Auto,Auto,*">
		            <Border BorderThickness="0,0,0,1" Grid.Row="0">
                        <DockPanel Margin="15, 10">
						    <TextBlock DockPanel.Dock="Right" Classes="subtitle" FontSize="10" LetterSpacing="1.5" Text="{Binding CalibrationRows.Count, StringFormat='{}{0} pts'}"/>

						    <TextBlock DockPanel.Dock="Left" Classes="subtitle" FontSize="10" LetterSpacing="1.5" Text="CALIBRATION POINTS"/>
                        </DockPanel>
                    </Border>
                
                    <Border BorderThickness="0,0,0,1" Grid.Row="1" Background="{StaticResource Surface2}">
					    <StackPanel Orientation="Horizontal" Margin="15,5" Spacing="12">
						    <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}"/>
                                <TextBlock Classes="subtitle" Text="&lt; 1°"/>
                            </StackPanel>

						    <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Caution}"/>
                                <TextBlock Classes="subtitle" Text="1-2°"/>
                            </StackPanel>

						    <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Warn}"/>
                                <TextBlock Classes="subtitle" Text="&gt; 2°"/>
                            </StackPanel>

						    <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource BorderColor}"/>
                                <TextBlock Classes="subtitle" Text="not recorded"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid Name="CalibrationGrid" Grid.Row="2"
                                GridLinesVisibility="Horizontal"
                                ItemsSource="{Binding CalibrationRows}"
                                IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="WELL"
                                                Binding="{Binding Well}"
                                                Width="*"
                                                MinWidth="70"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource Accent}"/>

                            <DataGridTextColumn Header="X / Y"
                                                Binding="{Binding XY}"
                                                MinWidth="85"
                                                Width="*"/>

                            <DataGridTemplateColumn Header="ERR L" Width="2*" SortMemberPath="ErrLVal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" 
                                                    VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding ErrL}"
                                                        FontSize="10"
                                                        Foreground="{Binding ErrLColor}"/>
                                            <Border Height="3" 
                                                    Width="{Binding ErrLBarWidth}" 
                                                    CornerRadius="2"
                                                    Background="{Binding ErrLColor}"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ERR R" Width="2*" SortMemberPath="ErrRVal">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" 
                                                    VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding ErrR}"
                                                        FontSize="10"
                                                        Foreground="{Binding ErrRColor}"/>
                                            <Border Height="3" 
                                                    Width="{Binding ErrRBarWidth}" 
                                                    CornerRadius="2"
                                                    Background="{Binding ErrRColor}"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
